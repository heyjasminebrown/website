# Contact form email delivery via https://resend.com (free tier is fine).
# Without RESEND_API_KEY the form logs messages in dev and shows your email address in production.
RESEND_API_KEY=
# Verified sender on your domain once set up in Resend, e.g. "Website <hello@heyjasminebrown.com>"
CONTACT_FROM_EMAIL=
# Where enquiries are delivered (defaults to the email in src/content/site.ts)
CONTACT_TO_EMAIL=
