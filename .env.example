# Contact form email delivery via https://resend.com (free tier is fine).
# Without RESEND_API_KEY the form logs messages in dev and shows your email address in production.
RESEND_API_KEY=
# Verified sender on your domain once set up in Resend, e.g. "Website <hello@heyjasminebrown.com>"
CONTACT_FROM_EMAIL=
# Where enquiries are delivered (defaults to the email in src/content/site.ts)
CONTACT_TO_EMAIL=

# Lead storage in Supabase (https://supabase.com). Create the table by running supabase/leads.sql
# in the Supabase SQL Editor. Both values are under Project Settings → API.
# The service role key is secret: set it only in Vercel / .env.local, never in client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
